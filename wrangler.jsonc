{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zhangpeng-app",
  "main": "./worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
